# Machine-specific root folders.  Copy this file to .env (gitignored) and edit
# it for your machine, or set the same variables in your shell / job script,
# which take precedence over .env.  Per-simulation paths, relative to these
# roots, go in config.py.  ~ and ${VAR} are expanded.

ATHENAK_DIR=/path/to/athenak            # AthenaK checkout; runs live under it
ATHINPUT_DIR=${ATHENAK_DIR}/inputs/hydro  # athinput files

# Conda environment direnv activates in the repo (see .envrc)
CONDA_ENV=vis_athenak
