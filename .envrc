# direnv: on cd into the repo, load .env and activate its conda environment
# (CONDA_ENV), so `python main.py` uses it.  Run `direnv allow` once, and
# again after editing this file.
if [[ -f .env ]]; then
    dotenv .env
fi
if [[ -n "${CONDA_ENV:-}" ]]; then
    conda_exe="${CONDA_EXE:-$(command -v conda || echo "$HOME/miniconda3/bin/conda")}"
    layout anaconda "$CONDA_ENV" "$conda_exe"
fi
